# LineageOS overrides on top of a02q_ltn_open_defconfig.

# Pronto WLAN (CAF prima 3.0.11.85.9, same as stock) from drivers/staging/prima,
# built in: init is deferred until libwifi-hal writes the fwpath parameter,
# so the Wi-Fi HAL never has to insmod (which fails once the module is live).
CONFIG_PRONTO_WLAN=y
